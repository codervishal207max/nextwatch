DATABASE_URL=sqlite:///./nextwatch.db
# Production: postgresql+psycopg2://username:password@localhost:5432/nextwatch
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:5173
# Free key from themoviedb.org, only needed for scripts/import_tmdb.py
TMDB_API_KEY=
# Google sign-in: OAuth Client ID (Web application) from console.cloud.google.com
GOOGLE_CLIENT_ID=
